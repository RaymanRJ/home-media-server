# Settings for this server. ./setup.sh copies this file to .env (in the repo's root, gitignored)
# and fills in the first section for you; every stack reads that .env. Change a setting, then
# restart its stack (or just run ./setup.sh --start again).

# --- This machine (setup.sh fills these in) -------------------------------------------------------
# The folder that holds each app's settings (.jellyfin-config, .sonarr, ...): your home folder.
CONFIG_ROOT=/home/me
# The user and group that own your media (`id -u`, `id -g`); the apps run as them.
PUID=1000
PGID=1000
# Your time zone, as `timedatectl` shows it.
TZ=Etc/UTC
# Where the backup notes its result and the weekly report writes its lists of files.
STATUS_DIR=/home/me/media-server/status
INVENTORY_DIR=/home/me/media-server/inventory

# --- Your media -----------------------------------------------------------------------------------
# The folder with your Movies, TV and so on (or a mergerfs pool of several drives).
MEDIA_POOL=/mnt/media

# --- What to run ----------------------------------------------------------------------------------
# Optional parts, comma-separated. Jellyfin always runs; leave this empty for Jellyfin alone, at home.
#   downloads  request shows and films in Seerr and have them downloaded and filed automatically
#   https      HTTPS on your own name, to watch away from home (pick duckdns or route53 too, below)
#   duckdns    a free yourname.duckdns.org name that follows your home IP (no AWS)
#   route53    your own domain in AWS Route 53 instead (needs the AWS setup in terraform/)
# Examples: "downloads"   "downloads,https,duckdns"
COMPOSE_PROFILES=downloads

# --- Away from home (only with https in COMPOSE_PROFILES) -----------------------------------------
# The name people use for Jellyfin, and for Seerr (the request page). With DuckDNS:
# yourname.duckdns.org and requests.yourname.duckdns.org (DuckDNS answers for both).
JELLYFIN_DOMAIN=
SEERR_DOMAIN=
# DuckDNS: sign in at https://www.duckdns.org, add a subdomain, and copy it (without
# .duckdns.org) and your token here.
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# --- Email alerts (optional) ----------------------------------------------------------------------
# Where the watchdog, drive warnings and the weekly report send email. Any email account works,
# e.g. Gmail with an app password (Google Account > Security > App passwords):
#   smtp://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:587/?from=you@gmail.com&to=you@gmail.com
# Characters like @ or / in the username or password must be written as %40 and %2F.
# Leave it empty for no email: the watchdog still restarts stuck apps, and the weekly report is off.
SMTP_URL=

# --- App keys (fill in as you set each app up) ----------------------------------------------------
# Beszel's agent: from the Beszel page (:8090), "Add system".
BESZEL_AGENT_KEY=
BESZEL_AGENT_TOKEN=
# Jellyfin, for the backup and the weekly report: Dashboard > API Keys.
JELLYFIN_API_KEY=
# Sonarr and Radarr, for Recyclarr and the weekly report: each one's Settings > General.
SONARR_API_KEY=
RADARR_API_KEY=
# Seerr, for the weekly report: its Settings > General.
SEERR_API_KEY=

# --- Backup (optional) ----------------------------------------------------------------------------
# A shared folder on a NAS or another computer (SMB), and a password that encrypts the backup.
# Keep the password somewhere safe as well: without it the backup can't be restored.
BACKUP_SHARE=//nas.local/Public
RESTIC_PASSWORD=

# --- Samba file shares ----------------------------------------------------------------------------
# The login name for the share and the folder it shares (setup.sh fills both in and creates the
# folder). Its password is set once after the first start: README, "File shares".
SAMBA_USER=me
SAMBA_SHARE_DIR=/home/me/share

# --- Weekly report extras (optional) --------------------------------------------------------------
# Names for the drives Scrutiny sees (the devices in compose.override.yaml), e.g. sda=system,sdb=disk1.
SCRUTINY_DRIVE_LABELS=
# A top-level folder on the data drives to list in its own file, e.g. a private share.
PRIVATE_DIR=

# --- AWS (optional, advanced: only with route53 in COMPOSE_PROFILES) ------------------------------
# Paste `terraform output -raw server_env` from terraform/ over these.
HOSTED_ZONE_ID=
TRUST_ANCHOR_ARN=
PROFILE_ARN=
ROLE_ARN=
