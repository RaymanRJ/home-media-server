# Copy to .env (gitignored) in the repo's root. Every stack reads it: each stacks/<name>/.env is a
# link to it.

# The download apps in the media stack (qBittorrent, Prowlarr, Sonarr, Radarr, Bazarr, Seerr,
# Cleanuparr, Recyclarr). Leave empty to run Jellyfin and Caddy without them.
COMPOSE_PROFILES=downloads

# --- This machine ---------------------------------------------------------------------------------
# The folder that holds each app's data folder (.jellyfin-config, .caddy, .sonarr, ...), usually
# your home directory. Keep it under /home or /mnt if Docker is the snap.
CONFIG_ROOT=/home/me
# The media library: the mergerfs pool, or any single folder.
MEDIA_POOL=/mnt/media
# The backup's status file (read by the watchdog and the weekly report) and the weekly report's
# inventory CSVs.
STATUS_DIR=/home/me/media-server/status
INVENTORY_DIR=/home/me/media-server/inventory
# Your time zone, as in `timedatectl`.
TZ=Etc/UTC
# The user and group that own the media (`id -u`, `id -g`); the download apps and Samba run as them.
PUID=1000
PGID=1000

# --- Samba ----------------------------------------------------------------------------------------
# The login name for the share (its password is set with smbpasswd), and the folder it shares.
SAMBA_USER=me
SAMBA_SHARE_DIR=/mnt/share

# --- Backup ---------------------------------------------------------------------------------------
# The SMB share the backup goes to, e.g. a NAS's guest share.
BACKUP_SHARE=//nas.local/Public

# --- Weekly report --------------------------------------------------------------------------------
# Optional. Names for the drives as Scrutiny sees them inside its container (the devices mapped in
# compose.override.yaml), e.g. sda=system,sdb=disk1. Empty shows the device names.
SCRUTINY_DRIVE_LABELS=
# Optional. A top-level folder on the data drives to list in its own CSV instead of all-files.csv,
# e.g. a private Samba share. Empty for none.
PRIVATE_DIR=

# --- Domains and AWS ------------------------------------------------------------------------------
JELLYFIN_DOMAIN=jellyfin.example.com
# Seerr's public name, behind Caddy; `terraform output seerr_url`.
SEERR_DOMAIN=requests.example.com

# For the dns-updater: paste `terraform output -raw server_env` from terraform/ over these.
HOSTED_ZONE_ID=Z0123456789EXAMPLE
TRUST_ANCHOR_ARN=arn:aws:rolesanywhere:us-east-2:111122223333:trust-anchor/EXAMPLE
PROFILE_ARN=arn:aws:rolesanywhere:us-east-2:111122223333:profile/EXAMPLE
ROLE_ARN=arn:aws:iam::111122223333:role/media-dns-updater

# For the Beszel agent: from the Beszel hub, "Add system".
BESZEL_AGENT_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEXAMPLE
BESZEL_AGENT_TOKEN=00000000-0000-0000-0000-000000000000

# Where Scrutiny sends drive warnings: a Shoutrrr SMTP URL, here SES's SMTP endpoint. Leave it
# empty to have no notifications. Characters like @ or / in the password must be URL-encoded.
SCRUTINY_NOTIFY_URLS=smtp://SMTP_USERNAME:SMTP_PASSWORD@email-smtp.us-east-1.amazonaws.com:587/?from=noreply@example.com&to=you@example.com

# For the nightly backup (Jellyfin's database backup) and the weekly report: a Jellyfin API key,
# from Dashboard > API Keys. Both read it on every run, so a new one needs no restart.
JELLYFIN_API_KEY=0123456789abcdef0123456789abcdef

# For Recyclarr: Sonarr's and Radarr's API keys, from each one's
# Settings > General once it has started.
SONARR_API_KEY=00000000000000000000000000000000
RADARR_API_KEY=00000000000000000000000000000000

# For the weekly report's incomplete shows: Seerr's API key, from its Settings > General.
SEERR_API_KEY=00000000000000000000000000000000

# The nightly backup: the password that encrypts it. Keep it in a password
# manager as well: without it the backup can't be restored.
RESTIC_PASSWORD=a-long-random-passphrase
