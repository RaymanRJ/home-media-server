[Unit]
# One unit per stack: home-media@media, home-media@monitoring, home-media@samba.
Description=Home media server: the %i stack, via Docker Compose
# For Docker from the snap: snap.docker.dockerd.service here and below, and /snap/bin/docker-compose
# instead of /usr/bin/docker compose.
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
# Where this repo is checked out.
WorkingDirectory=/opt/home-media-server/stacks/%i
# Docker's unit counts as started before its socket accepts connections, so wait until it answers.
ExecStartPre=/bin/sh -c 'until /usr/bin/docker info >/dev/null 2>&1; do sleep 2; done'
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
RemainAfterExit=true
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
